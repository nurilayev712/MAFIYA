# Server Konfiguratsiyasi
PORT=7122
NODE_ENV=production

# Xavfsizlik va Maxfiy Kalitlar (Hech qachon ochiq kodga yozilmasin!)
JWT_SECRET=super_secret_jwt_random_key_production_7122
ADMIN_SECRET_KEY=admin7122

# Redis Adapter (Gorizontal masshtablash va kesh)
REDIS_URL=redis://localhost:6379

# Ma'lumotlar Bazasi (MongoDB yoki PostgreSQL)
DATABASE_URL=mongodb://localhost:27017/mafiya

# Monitoring va Sentry Error Tracking
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# AI Botlar uchun Anthropic Claude API (Ixtiyoriy)
ANTHROPIC_API_KEY=sk-ant-api03-...

# O'yin Xavfsizligi va Limitlar
DISCONNECT_GRACE_SECONDS=60
RATE_LIMIT_CHAT_PER_SEC=4
